{
  "name": "bug-tracker-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Bug and issue tracker for game development with Kanban, milestones and Firebase cloud sync.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o tailwind.css --watch",
    "test": "node --test \"tests/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bug-tracker \"node --test tests/rules/*.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:functions": "firebase deploy --only functions",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-admin": "12.7.0",
    "firebase-tools": "13.29.1",
    "tailwindcss": "3.4.17"
  }
}
