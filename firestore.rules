rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teammates allowed to use the tracker (Google account emails, lowercase).
    // Add one email per line, then publish these rules in the Firebase console.
    function isTeamMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'your-email@example.com'
        ];
    }

    match /workspaces/{workspace}/{document=**} {
      allow read, write: if isTeamMember();
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
