rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in users may touch the shared workspace.
    // NOTE: anonymous sign-in means anyone who opens the site counts as signed in.
    // For real privacy, switch to Google/email sign-in and check request.auth.uid
    // against an allow-list of teammates.
    match /workspaces/{workspace}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
